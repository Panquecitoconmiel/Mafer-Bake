# ───────── Servidor ─────────
NODE_ENV=development
PORT=4000
# URL pública del frontend (CORS, enlaces de correo y redirecciones de Stripe)
CLIENT_URL=http://localhost:5173
# Orígenes extra permitidos, separados por comas (opcional)
CORS_ORIGINS=

# ───────── Base de datos (MySQL 8) ─────────
# Si tu contraseña tiene símbolos (@ # / : %), codifícalos: @ → %40, # → %23
DATABASE_URL=mysql://root:TU_CONTRASEÑA@localhost:3306/mafer
# Base de datos exclusiva para pruebas automatizadas (se vacía en cada ejecución)
TEST_DATABASE_URL=mysql://root:TU_CONTRASEÑA@localhost:3306/mafer_test

# ───────── Sesiones ─────────
# Duración de la sesión en días
SESSION_TTL_DAYS=14

# ───────── Stripe (usa claves de PRUEBA: sk_test_ / pk_test_) ─────────
# Si STRIPE_SECRET_KEY queda vacío, la tienda funciona pero el pago se muestra como no disponible.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Se obtiene con `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mxn

# ───────── Primer administrador (solo para `pnpm admin:create`) ─────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# ───────── Correo ─────────
# Aún no hay proveedor SMTP integrado: en desarrollo los enlaces de verificación
# y recuperación se imprimen en la consola del servidor.
MAIL_FROM="Mafer <no-reply@example.com>"

# ───────── Tienda ─────────
# Zona horaria usada para validar fechas y horarios de entrega
STORE_TIMEZONE=America/Mexico_City
