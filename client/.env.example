# URL base de la API. En desarrollo se usa el proxy de Vite (/api → localhost:4000),
# así que normalmente no hace falta cambiarla.
VITE_API_URL=/api/v1

# Muestra el aviso "Productos y precios de demostración" en la parte superior.
# Cámbialo a false cuando el catálogo real esté cargado.
VITE_DEMO_NOTICE=true
